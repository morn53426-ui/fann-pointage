# FANN POINTAGE — modèle sans secret. Copiez vers .env puis remplacez toutes les valeurs indiquées.
# Ne versionnez jamais le fichier .env réel.
FANN_MODE=postgres-catalogue
FANN_MDP_PROVISOIRE=aleatoire
# Laisser vide en local. compose.vps.yaml force FANN_ENV=production pour le service public.
FANN_ENV=

# Domaine et courriel requis uniquement pour le déploiement HTTPS VPS.
FANN_HOSTNAME=pointage.example.org
ACME_EMAIL=administrateur@example.org

HOST=0.0.0.0
PORT=8787
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8787
TRUST_PROXY=0
DEMO_MOT_DE_PASSE=

# Renseigner les coordonnées GPS réelles uniquement après validation sur site.
ZONE_LAT=
ZONE_LNG=
ZONE_RAYON=150

POSTGRES_DB=fann_pointage
POSTGRES_USER=fann_admin
POSTGRES_PASSWORD=REMPLACER_PAR_UN_SECRET_ALEATOIRE_URL_SAFE
POSTGRES_APP_USER=fann_app
POSTGRES_APP_PASSWORD=REMPLACER_PAR_UN_AUTRE_SECRET_ALEATOIRE_URL_SAFE
POSTGRES_PORT=54329
# URLs de connexion pour les scripts lancés depuis l'hôte (ne pas partager après remplacement).
DATABASE_URL=postgresql://fann_app:REMPLACER_PAR_UN_SECRET_ALEATOIRE_URL_SAFE@127.0.0.1:54329/fann_pointage
DATABASE_ADMIN_URL=postgresql://fann_admin:REMPLACER_PAR_UN_SECRET_ALEATOIRE_URL_SAFE@127.0.0.1:54329/fann_pointage

SESSION_SECRET=REMPLACER_PAR_UN_SECRET_ALEATOIRE_D_AU_MOINS_32_OCTETS
BADGE_SECRET=REMPLACER_PAR_UN_SECRET_ALEATOIRE_D_AU_MOINS_32_OCTETS
ADMIN_INITIAL_MOT_DE_PASSE=REMPLACER_PAR_UN_MOT_DE_PASSE_FORT

PG_POOL_MAX=10
PG_CONNECT_TIMEOUT_MS=5000
PG_IDLE_TIMEOUT_MS=30000
PG_STATEMENT_TIMEOUT_MS=60000
PG_IDLE_TX_TIMEOUT_MS=15000
PG_LOCK_TIMEOUT_MS=5000
PGSSL=

APP_MEMORY_LIMIT=384m
APP_CPU_LIMIT=1.0
MIGRATE_MEMORY_LIMIT=256m
MIGRATE_CPU_LIMIT=1.0
DB_MEMORY_LIMIT=1g
DB_CPU_LIMIT=1.0
DB_SHM_SIZE=256mb

# Sauvegardes : rétention par défaut 14 archives ; clé par défaut ~/.fann-backup.key.
# BACKUP_KEEP_LOCAL et BACKUP_KEY_FILE peuvent être exportées dans l'environnement du cron si nécessaire.
# Destination rsync/SSH facultative, ex. backup@serveur:/srv/fann
BACKUP_RSYNC_DEST=

# Windows / PowerShell compatibility : dossier réseau puis destination SSH (séparés par un point-virgule).
BACKUP_DEST=\\serveur\partage;backup@serveur:/srv/fann
