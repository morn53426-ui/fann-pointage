{
    email {$ACME_EMAIL}
}

# Le nom public canonique est fourni par compose.vps.yaml via FANN_HOSTNAME.
{$FANN_HOSTNAME} {
    encode zstd gzip

    header {
        Strict-Transport-Security "max-age=31536000"
        -Server
    }

    request_body {
        max_size 256KB
    }

    reverse_proxy app:8787 {
        header_up X-Forwarded-For {remote_host}
    }
}
